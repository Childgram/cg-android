#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
[[ $# == 0 ]] || { echo 'Usage: ./dev/check-maps' >&2; exit 1; }
variant=debug
package=org.childgram.messenger.beta

docker run --rm -i --network none --platform linux/amd64 \
    -v "$PWD:/workspace" -w /workspace childgram-android:36-ndk27 bash -se -- "$variant" "$package" <<'CHECK'
set -euo pipefail
umask 077
variant=$1
package=$2
out=.local/checks/maps-$variant
classes=TMessagesProj/build/intermediates/runtime_library_classes_jar/$variant/bundleLibRuntimeToJar${variant^}/classes.jar
android="$ANDROID_HOME/platforms/android-36/android.jar"
buildtools="$ANDROID_HOME/build-tools/36.0.0"
mkdir -p "$out/classes" "$out/dex"
javac -cp "$classes:$android" -d "$out/classes" dev/tests/ChildgramMapsInstrumentation.java
cat > "$out/AndroidManifest.xml" <<EOF
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="$package.mapschecks">
    <application android:label="Childgram maps checks" />
    <instrumentation android:name="org.telegram.messenger.ChildgramMapsInstrumentation" android:targetPackage="$package" />
</manifest>
EOF
jar cf "$out/tests.jar" -C "$out/classes" .
"$buildtools/d8" --min-api 26 --lib "$android" --classpath "$classes" --output "$out/dex" "$out/tests.jar"
"$buildtools/aapt2" link -I "$android" --manifest "$out/AndroidManifest.xml" --min-sdk-version 26 --target-sdk-version 34 -o "$out/tests-unaligned.apk"
jar uf "$out/tests-unaligned.apk" -C "$out/dex" classes.dex
"$buildtools/zipalign" -f 4 "$out/tests-unaligned.apk" "$out/tests.apk"
"$buildtools/apksigner" sign --ks .local/debug.keystore --ks-pass pass:android "$out/tests.apk"
CHECK

./dev/emulator adb install -r ".local/checks/maps-$variant/tests.apk"
result=$(./dev/emulator adb shell am instrument -w "$package.mapschecks/org.telegram.messenger.ChildgramMapsInstrumentation")
printf '%s\n' "$result"
[[ "$result" == *'INSTRUMENTATION_CODE: -1'* && "$result" == *'status=passed'* ]]
./dev/emulator adb pull "/sdcard/Android/data/$package/files/maps-checks/location-viewer.png" ".local/checks/maps-$variant/location-viewer.png"
