#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
[[ $# == 0 || $# == 1 && $1 == --device ]] || { echo 'Usage: ./dev/check-parental [--device]' >&2; exit 1; }

# Build first with ./dev/build. The check does not open an activity or write to Telegram.
docker run --rm -i --network none --platform linux/amd64 \
    -v "$PWD:/workspace" -w /workspace childgram-android:36-ndk27 bash -se <<'CHECK'
set -euo pipefail
umask 077
out=.local/checks/parental-debug
classes=TMessagesProj/build/intermediates/runtime_library_classes_jar/debug/bundleLibRuntimeToJarDebug/classes.jar
android="$ANDROID_HOME/platforms/android-36/android.jar"
buildtools="$ANDROID_HOME/build-tools/36.0.0"
mkdir -p "$out/classes" "$out/dex"
javac -cp "$classes:$android" -d "$out/classes" dev/tests/ChildgramParentalInstrumentation.java
cat > "$out/AndroidManifest.xml" <<'EOF'
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.childgram.parentalchecks">
    <application android:label="Childgram parental checks" />
    <instrumentation android:name="org.telegram.messenger.ChildgramParentalInstrumentation" android:targetPackage="org.childgram.messenger.beta" />
</manifest>
EOF
jar cf "$out/tests.jar" -C "$out/classes" .
"$buildtools/d8" --min-api 26 --lib "$android" --classpath "$classes" --output "$out/dex" "$out/tests.jar"
"$buildtools/aapt2" link -I "$android" --manifest "$out/AndroidManifest.xml" --min-sdk-version 26 --target-sdk-version 34 -o "$out/tests-unaligned.apk"
jar uf "$out/tests-unaligned.apk" -C "$out/dex" classes.dex
"$buildtools/zipalign" -f 4 "$out/tests-unaligned.apk" "$out/tests.apk"
"$buildtools/apksigner" sign --ks .local/debug.keystore --ks-pass pass:android "$out/tests.apk"
CHECK

if [[ ${1:-} == --device ]]; then
    ./dev/emulator adb install -r .local/checks/parental-debug/tests.apk
    result=$(./dev/emulator adb shell am instrument -w org.childgram.parentalchecks/org.telegram.messenger.ChildgramParentalInstrumentation)
    printf '%s\n' "$result"
    [[ "$result" == *'INSTRUMENTATION_CODE: -1'* && "$result" == *'status=passed'* ]]
fi
