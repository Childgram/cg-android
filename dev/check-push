#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
[[ $# == 0 || ( $# == 1 && "${1:-}" == --release ) ]] || { echo 'Usage: ./dev/check-push [--release]' >&2; exit 1; }
variant=debug
package=org.childgram.messenger.beta
if [[ "${1:-}" == --release ]]; then variant=release; package=org.childgram; fi

docker run --rm -i --network none --platform linux/amd64 \
    -v "$PWD:/workspace" -w /workspace childgram-android:36-ndk27 bash -se -- "$variant" "$package" <<'CHECK'
set -euo pipefail
umask 077
variant=$1
package=$2
out=.local/checks/push-$variant
classes=TMessagesProj/build/intermediates/runtime_library_classes_jar/$variant/bundleLibRuntimeToJar${variant^}/classes.jar
android="$ANDROID_HOME/platforms/android-36/android.jar"
buildtools="$ANDROID_HOME/build-tools/36.0.0"
mkdir -p "$out/classes" "$out/dex"
javac -cp "$classes:$android" -d "$out/classes" dev/tests/ChildgramPushInstrumentation.java
cat > "$out/AndroidManifest.xml" <<EOF
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="$package.pushchecks">
    <application android:label="Childgram push checks" />
    <instrumentation android:name="org.telegram.messenger.ChildgramPushInstrumentation" android:targetPackage="$package" />
</manifest>
EOF
jar cf "$out/tests.jar" -C "$out/classes" .
"$buildtools/d8" --min-api 26 --lib "$android" --classpath "$classes" --output "$out/dex" "$out/tests.jar"
"$buildtools/aapt2" link -I "$android" --manifest "$out/AndroidManifest.xml" --min-sdk-version 26 --target-sdk-version 34 -o "$out/tests-unaligned.apk"
jar uf "$out/tests-unaligned.apk" -C "$out/dex" classes.dex
"$buildtools/zipalign" -f 4 "$out/tests-unaligned.apk" "$out/tests.apk"
if [[ "$variant" == release ]]; then
    "$buildtools/apksigner" sign --ks .local/signing/childgram-release.p12 --ks-key-alias childgram --ks-pass file:.local/signing/password.txt "$out/tests.apk"
else
    "$buildtools/apksigner" sign --ks .local/debug.keystore --ks-pass pass:android "$out/tests.apk"
fi
CHECK

./dev/emulator adb install -r ".local/checks/push-$variant/tests.apk"
result=$(./dev/emulator adb shell am instrument -w "$package.pushchecks/org.telegram.messenger.ChildgramPushInstrumentation")
printf '%s\n' "$result"
[[ "$result" == *'INSTRUMENTATION_CODE: -1'* ]]
